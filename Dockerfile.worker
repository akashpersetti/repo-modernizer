FROM python:3.12-slim

# Node.js: the worker runs a cloned target repo's OWN test_command, and that repo
# might not be Python (file_extensions is configurable -- see plan_node). Installed
# via NodeSource for a current LTS rather than Debian's bundled version, which can
# lag significantly depending on the base image's release.
RUN apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml uv.lock ./
# dev deps (pytest, flask) ship here deliberately: the worker's job is to run
# a cloned target repo's own test_command, and those two are the toolchain
# repomodernizer's own migration fixtures/demo targets are built against.
RUN pip install --no-cache-dir uv \
    && uv export --frozen -o requirements.txt \
    && grep -v "^-e" requirements.txt > requirements-prod.txt \
    && pip install --no-cache-dir -r requirements-prod.txt

COPY app ./app

ENTRYPOINT ["python", "-m", "app.worker.entrypoint"]
